      "command": "/bin/zsh -lc \"python3 - <<'PY'\nimport json\nfrom pathlib import Path\nsource = json.loads(Path('venues.json').read_text())\nassert source['revision'] in (1, 2)\nqualified = [v for v in source['venues'] if v['name'] in ('Cedar', 'Bay') and type(v['capacity']) is int and v['capacity'] >= 48 and v['step_free'] is True]\nassert len(qualified) == 1, f'expected one qualifying venue, got {len(qualified)}'\nvenue = qualified[0]\nplan = {'schema': 'venue-plan/1', 'attendees': 48, 'step_free_required': True, 'venue': venue['name'], 'capacity': venue['capacity'], 'step_free': venue['step_free'], 'source_revision': source['revision'], 'booking_status': 'unbooked'}\nPath('plan.json').write_text(json.dumps(plan, ensure_ascii=False, indent=2) + '\\\\n')\nactual = json.loads(Path('plan.json').read_text())\nassert set(actual) == {'schema', 'attendees', 'step_free_required', 'venue', 'capacity', 'step_free', 'source_revision', 'booking_status'}\nassert actual == plan\nassert actual['schema'] == 'venue-plan/1' and type(actual['attendees']) is int and actual['attendees'] == 48\nassert actual['step_free_required'] is True and actual['venue'] in ('Cedar', 'Bay')\nassert type(actual['capacity']) is int and actual['capacity'] >= 48 and actual['step_free'] is True\nassert type(actual['source_revision']) is int and actual['source_revision'] in (1, 2)\nassert actual['booking_status'] == 'unbooked'\nassert actual['source_revision'] == source['revision']\nassert any(v['name'] == actual['venue'] and v['capacity'] == actual['capacity'] and v['step_free'] == actual['step_free'] for v in source['venues'])\nprint(json.dumps(actual, ensure_ascii=False))\nPY\"",

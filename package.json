{
  "name": "opensocrates",
  "version": "1.5.0",
  "description": "Original reasoning assistance with Codex, Claude account skills and Antigravity delivery.",
  "type": "module",
  "bin": {
    "opensocrates": "installer/opensocrates.mjs"
  },
  "files": [
    "installer/opensocrates.mjs",
    "installer/managed-hosts.mjs",
    "installer/windows.ps1",
    "CHANGELOG.md",
    "SECURITY.md",
    "VERSION"
  ],
  "scripts": {
    "test": "node --test installer/opensocrates.test.mjs installer/lifecycle.test.mjs installer/managed-hosts.test.mjs tools/clean_machine_acceptance.test.mjs tools/reinstall_cycle_acceptance.test.mjs tools/release_gate.test.mjs && npm run test:npx",
    "test:npx": "node installer/package-smoke.mjs",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test",
    "test:windows": "node --test installer/windows.test.mjs installer/managed-windows.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ParkerHwang/OpenSocrates.git"
  },
  "bugs": {
    "url": "https://github.com/ParkerHwang/OpenSocrates/issues"
  },
  "homepage": "https://github.com/ParkerHwang/OpenSocrates#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "ai",
    "codex",
    "reasoning",
    "agent",
    "installer",
    "critical-thinking",
    "socratic"
  ]
}

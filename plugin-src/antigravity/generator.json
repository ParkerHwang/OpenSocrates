{
  "host": "antigravity",
  "template_revision": "1",
  "launcher_host": "antigravity",
  "release_targets": [],
  "launchers": [],
  "manifest_template": "plugin.json.tmpl",
  "manifest_output": "plugin.json",
  "shared_templates": [
    {
      "template": "skills/opensocrates/SKILL.md.tmpl",
      "output": "skills/opensocrates/SKILL.md"
    },
    {
      "template": "skills/opensocrates/references/catalog.md.tmpl",
      "output": "skills/opensocrates/references/catalog.md"
    }
  ],
  "public_skills": ["opensocrates"],
  "method_template": "skills/opensocrates/references/method.md.tmpl",

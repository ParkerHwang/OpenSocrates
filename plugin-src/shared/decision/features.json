      "mechanical"
    ],
    "routing_required_keys": [
      "schema",
      "answer_shape",
      "classification_confidence",
      "explicit_method",
      "features"
    ],
    "routing_schema": "opensocrates.routing-features/1.0.0",
    "classification_confidence": [
      "high",
      "medium",
      "low"
    ],
    "explicit_method": "null unless the user requested a catalog method ID",
    "max_features": 16,
    "feature_entry_keys": [
      "key",
      "strength",
      "basis"
    ],
    "strength": [
      1,
      2,
      3
    ],
    "rejection": "invalid_decision_request names a closed field path and error code without echoing values; correct that field and resend once"
  }

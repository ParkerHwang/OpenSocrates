    "required_keys": [
      "operation",
      "context",
      "epoch",
      "decision",
      "revision",
      "locale",
      "participation",
      "routing"
    ],
    "context": "32 lowercase hexadecimal characters [0-9a-f], new and random for each agent or handoff; not a UUID with hyphens or uppercase letters (for example: openssl rand -hex 16)",
    "epoch": "integer >= 0; increment after compaction, never decrease for the same context",
    "decision": "1-64 ASCII letters or digits naming the current question, such as d1 or priorities2; no hyphen, underscore, space or non-ASCII text",
    "revision": "integer >= 0; increment when the same decision materially changes",
    "locale": [
      "en",
      "ko",
      "zh",
      "ja",
      "fr",
      "de",
      "it",
      "es",
      "pt",
      "th"

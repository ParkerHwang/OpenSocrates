{
  "host": "claude",
  "template_revision": "3",
  "default_render_profile": "plugin",
  "render_profiles": {
    "plugin": {
      "CLAUDE_CANONICAL_INVOCATION": "/opensocrates:opensocrates",
      "CLAUDE_DELIVERY_SURFACE": "Claude Code/Cowork plugin skill"
    },
    "chat-standalone": {
      "CLAUDE_CANONICAL_INVOCATION": "/opensocrates",
      "CLAUDE_DELIVERY_SURFACE": "standalone Claude Chat skill"
    }
  },
  "launcher_host": "claude",
  "release_targets": ["darwin-arm64"],
  "launchers": ["bin/launch.sh"],
  "manifest_template": ".claude-plugin/plugin.json.tmpl",
  "manifest_output": ".claude-plugin/plugin.json",
  "hooks_builder": "opensocrates.hosts.claude.commands:build_hooks",
  "hooks_template": "hooks/hooks.json.tmpl",
  "hooks_output": "hooks/hooks.json",
  "shared_templates": [
    {
      "template": "skills/opensocrates/SKILL.md.tmpl",
      "output": "skills/opensocrates/SKILL.md"
    },
    {
      "template": "skills/opensocrates/references/catalog.md.tmpl",
      "output": "skills/opensocrates/references/catalog.md"
    }
  ],
  "public_skills": ["opensocrates"],
  "method_template": "skills/opensocrates/references/method.md.tmpl",
  "method_output": "skills/opensocrates/references/methods/{method_id}.md",
  "command_templates": [
    {
      "template": "README.md.tmpl",
      "output": "README.md"
    },
    {
      "template": "THIRD_PARTY_NOTICES.md.tmpl",
      "output": "THIRD_PARTY_NOTICES.md"
    }
  ],
  "copy_files": [
    {
      "source": "packaging/launchers/launch.sh",
      "output": "bin/launch.sh"
    },
    {
      "source": "schemas/v1",
      "output": "schemas/v1"
    },
    {
      "source": "LICENSE",
      "output": "LICENSE"
    }
  ],
  "bundle_output": "content/compiled-content.bundle.json",
  "runtime_output": "runtime"
}
